<Application
    x:Class="Klip.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Styles/Keycaps.xaml" />
                <!-- RF-S.01: design system da tela de Configuracoes. Precisa vir DEPOIS
                     do ThemesDictionary e do ControlsDictionary, senao os overrides de
                     brush (NavigationViewItemBackgroundPointerOver) nao vencem. -->
                <ResourceDictionary Source="/Styles/Settings.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
