<Application
    x:Class="Klip.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:Klip.App.Services"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- parsed already on the saved theme, so startup doesn't parse Dark
                     and then swap to Light right after -->
                <services:StartupThemesDictionary />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Styles/Keycaps.xaml" />
                <!-- has to come after the theme and controls dictionaries, otherwise
                     the brush overrides (NavigationViewItemBackgroundPointerOver) lose -->
                <ResourceDictionary Source="/Styles/Settings.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
