<Page
    x:Class="Klip.App.Views.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    Style="{StaticResource SettingsPage}">

    <!-- sem Background (mataria o Mica) e sem ScrollViewer. Ver SettingsShell.xaml. -->
    <controls:SettingsPanel Style="{StaticResource SettingsContent}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.SectionRecordingPage}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.RecordingsFolderTitle}"
            Description="{DynamicResource Loc.RecordingsFolderCaption}"
            Icon="&#xE8B7;">
            <controls:SettingsCard.Footer>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="RecordingsFolderBox" IsReadOnly="True" Style="{StaticResource SettingsTextBox}" />
                    <ui:Button
                        x:Name="ChooseRecordingsFolderButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        MinHeight="32"
                        Content="{DynamicResource Loc.ChooseFolder}" />
                </Grid>
            </controls:SettingsCard.Footer>
        </controls:SettingsCard>

        <!-- ================= Video ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.RecordingVideoHeader}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.Mp4FpsTitle}"
            Description="{DynamicResource Loc.Mp4FpsCaption}"
            Icon="&#xE916;">
            <ComboBox x:Name="Mp4FpsCombo" MinWidth="140" Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.Mp4QualityTitle}"
            Description="{DynamicResource Loc.Mp4QualityCaption}"
            Icon="&#xE9E9;">
            <ComboBox x:Name="Mp4QualityCombo" MinWidth="200" Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.Mp4ResolutionTitle}"
            Description="{DynamicResource Loc.Mp4ResolutionCaption}"
            Icon="&#xE740;">
            <ComboBox x:Name="Mp4ResolutionCombo" MinWidth="240" Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.Mp4ShowCursorTitle}"
            Description="{DynamicResource Loc.Mp4ShowCursorCaption}"
            Icon="&#xE7C9;">
            <ui:ToggleSwitch x:Name="ShowCursorToggle" />
        </controls:SettingsCard>

        <!-- ================= Audio ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionAudio}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.RecordingSystemAudio}"
            Description="{DynamicResource Loc.Mp4SystemAudioCaption}"
            Icon="&#xE767;">
            <ui:ToggleSwitch x:Name="SystemAudioToggle" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Title="{DynamicResource Loc.RecordingMicrophones}"
            Description="{DynamicResource Loc.Mp4MicrophonesCaption}"
            Icon="&#xE720;"
            IsExpanded="True">
            <controls:SettingsRow>
                <controls:SettingsRow.Footer>
                    <StackPanel x:Name="MicrophonesHost" Margin="0,-12,0,0" />
                </controls:SettingsRow.Footer>
            </controls:SettingsRow>
        </controls:SettingsExpander>

        <!-- ================= GIF ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.RecordingGifHeader}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.GifFpsTitle}"
            Description="{DynamicResource Loc.GifFpsCaption}"
            Icon="&#xF4A9;">
            <ComboBox x:Name="GifFpsCombo" MinWidth="200" Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.GifScaleTitle}"
            Description="{DynamicResource Loc.GifScaleCaption}"
            Icon="&#xE740;">
            <ComboBox x:Name="GifScaleCombo" MinWidth="140" Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>

        <!-- ================= Durante a gravacao ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionDuringRecording}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.HideRecordingBorderTitle}"
            Description="{DynamicResource Loc.HideRecordingBorderCaption}"
            Icon="&#xE7B3;">
            <ui:ToggleSwitch x:Name="HideRecordingBorderToggle" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Title="{DynamicResource Loc.RecordingAdvancedTitle}"
            Description="{DynamicResource Loc.RecordingAdvancedCaption}"
            Icon="&#xE90F;">
            <StackPanel>
                <controls:SettingsRow
                    x:Name="CodecCard"
                    Title="{DynamicResource Loc.Mp4CodecTitle}"
                    Description="{DynamicResource Loc.Mp4CodecCaption}">
                    <ComboBox x:Name="Mp4CodecCombo" MinWidth="180" Style="{StaticResource SettingsComboBox}" />
                </controls:SettingsRow>
                <controls:SettingsRow Title="{DynamicResource Loc.FfmpegPathTitle}" Description="{DynamicResource Loc.FfmpegPathCaption}">
                    <controls:SettingsRow.Footer>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="FfmpegPathBox" IsReadOnly="True" Style="{StaticResource SettingsTextBox}" />
                            <ui:Button
                                x:Name="ChooseFfmpegButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                MinHeight="32"
                                Content="{DynamicResource Loc.FfmpegChoose}" />
                        </Grid>
                    </controls:SettingsRow.Footer>
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsExpander>
    </controls:SettingsPanel>
</Page>
