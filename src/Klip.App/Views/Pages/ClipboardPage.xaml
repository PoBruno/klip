<Page
    x:Class="Klip.App.Views.Pages.ClipboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    xmlns:views="clr-namespace:Klip.App.Views.Controls"
    Style="{StaticResource SettingsPage}">

    <!-- sem Background (mataria o Mica) e sem ScrollViewer. Ver SettingsShell.xaml. -->
    <controls:SettingsPanel Style="{StaticResource SettingsContent}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.SectionClipboard}" />

        <!-- ================= Painel ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.HistorySectionFlyout}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.FlyoutOpenAtCaretTitle}"
            Description="{DynamicResource Loc.FlyoutOpenAtCaretCaption}"
            Icon="&#xE8AC;">
            <ui:ToggleSwitch x:Name="OpenAtCaretToggle" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.FlyoutRememberScrollTitle}"
            Description="{DynamicResource Loc.FlyoutRememberScrollCaption}"
            Icon="&#xE7C5;">
            <ui:ToggleSwitch x:Name="RememberScrollToggle" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.FlyoutEnterActionTitle}"
            Description="{DynamicResource Loc.FlyoutEnterActionCaption}"
            Icon="&#xE8FB;">
            <ComboBox x:Name="EnterActionCombo" MinWidth="240" Style="{StaticResource SettingsComboBox}">
                <ComboBoxItem Content="{DynamicResource Loc.FlyoutEnterPaste}" Tag="paste" />
                <ComboBoxItem Content="{DynamicResource Loc.FlyoutEnterCopy}" Tag="copy" />
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsExpander
            Title="{DynamicResource Loc.FlyoutTabsTitle}"
            Description="{DynamicResource Loc.FlyoutTabsCaption}"
            Icon="&#xE8A9;">
            <StackPanel>
                <controls:SettingsRow Title="{DynamicResource Loc.ShowEmojiTabTitle}" Description="{DynamicResource Loc.ShowEmojiTabCaption}">
                    <ui:ToggleSwitch x:Name="ShowEmojiTabToggle" />
                </controls:SettingsRow>
                <controls:SettingsRow Title="{DynamicResource Loc.ShowSnippetsTabTitle}" Description="{DynamicResource Loc.ShowSnippetsTabCaption}">
                    <ui:ToggleSwitch x:Name="ShowSnippetsTabToggle" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsExpander>

        <!-- ClearButtonEnabled=False: o "x" deixaria a caixa vazia com o valor antigo salvo -->
        <controls:SettingsExpander
            Title="{DynamicResource Loc.FlyoutSizeTitle}"
            Description="{DynamicResource Loc.FlyoutSizeCaption}"
            Icon="&#xE740;">
            <StackPanel>
                <controls:SettingsRow Title="{DynamicResource Loc.FlyoutWidthLabel}">
                    <ui:NumberBox
                        x:Name="FlyoutWidthBox"
                        Width="150"
                        Maximum="1600"
                        Minimum="360"
                        MaxDecimalPlaces="0"
                        SmallChange="10"
                        ClearButtonEnabled="False"
                        Style="{StaticResource SettingsNumberBox}" />
                </controls:SettingsRow>
                <controls:SettingsRow Title="{DynamicResource Loc.FlyoutHeightLabel}">
                    <ui:NumberBox
                        x:Name="FlyoutHeightBox"
                        Width="150"
                        Maximum="1600"
                        Minimum="460"
                        MaxDecimalPlaces="0"
                        SmallChange="10"
                        ClearButtonEnabled="False"
                        Style="{StaticResource SettingsNumberBox}" />
                </controls:SettingsRow>
                <controls:SettingsRow>
                    <ui:Button x:Name="FlyoutSizeResetButton" Content="{DynamicResource Loc.FlyoutSizeReset}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsExpander>

        <!-- ================= Colar ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionPaste}" />

        <controls:SettingsExpander
            x:Name="PlainTextExpander"
            Title="{DynamicResource Loc.AlwaysPlainTextTitle}"
            Description="{DynamicResource Loc.AlwaysPlainTextCaption}"
            Icon="&#xE8E9;">
            <controls:SettingsExpander.Header>
                <ui:ToggleSwitch x:Name="AlwaysPlainTextToggle" />
            </controls:SettingsExpander.Header>
            <controls:SettingsRow
                x:Name="RichPasteAppsCard"
                Title="{DynamicResource Loc.RichPasteAppsTitle}"
                Description="{DynamicResource Loc.RichPasteAppsCaption}">
                <controls:SettingsRow.Footer>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                x:Name="RichAppBox"
                                PlaceholderText="{DynamicResource Loc.ExcludedAppsPlaceholder}"
                                Style="{StaticResource SettingsTextBox}" />
                            <ui:Button
                                x:Name="AddRichAppButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                MinHeight="32"
                                Content="{DynamicResource Loc.AddApp}" />
                        </Grid>
                        <ItemsControl x:Name="RichAppsList" Style="{StaticResource AppListStyle}" />
                    </StackPanel>
                </controls:SettingsRow.Footer>
            </controls:SettingsRow>
        </controls:SettingsExpander>

        <controls:SettingsCard
            Title="{DynamicResource Loc.RestoreClipboardTitle}"
            Description="{DynamicResource Loc.RestoreClipboardCaption}"
            Icon="&#xE7A7;">
            <ui:ToggleSwitch x:Name="RestoreClipboardToggle" />
        </controls:SettingsCard>

        <!-- ================= Imagens como arquivo ================= -->
        <views:PasteAsFileSettings />

        <!-- ================= Limpeza automatica ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.HistorySectionRetention}" />
        <TextBlock Style="{StaticResource SectionNote}" Text="{DynamicResource Loc.RetentionNote}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.MaxItemsTitle}"
            Description="{DynamicResource Loc.MaxItemsCaption}"
            Icon="&#xE8F1;">
            <ui:NumberBox
                x:Name="MaxItemsBox"
                Width="150"
                Maximum="1000000"
                Minimum="0"
                MaxDecimalPlaces="0"
                SmallChange="100"
                ClearButtonEnabled="False"
                Style="{StaticResource SettingsNumberBox}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.MaxImagesTitle}"
            Description="{DynamicResource Loc.MaxImagesCaption}"
            Icon="&#xEB9F;">
            <ui:NumberBox
                x:Name="MaxImagesBox"
                Width="150"
                Maximum="100000"
                Minimum="0"
                MaxDecimalPlaces="0"
                SmallChange="10"
                ClearButtonEnabled="False"
                Style="{StaticResource SettingsNumberBox}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.MaxMediaTitle}"
            Description="{DynamicResource Loc.MaxMediaCaption}"
            Icon="&#xEDA2;">
            <StackPanel Orientation="Horizontal">
                <ui:NumberBox
                    x:Name="MaxMediaBox"
                    Width="150"
                    Maximum="1024"
                    Minimum="0"
                    MaxDecimalPlaces="1"
                    SmallChange="0.5"
                    ClearButtonEnabled="False"
                    Style="{StaticResource SettingsNumberBox}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Loc.MaxMediaUnit}" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.MaxAgeTitle}"
            Description="{DynamicResource Loc.MaxAgeCaption}"
            Icon="&#xE787;">
            <StackPanel Orientation="Horizontal">
                <ui:NumberBox
                    x:Name="MaxAgeBox"
                    Width="150"
                    Maximum="3650"
                    Minimum="0"
                    MaxDecimalPlaces="0"
                    ClearButtonEnabled="False"
                    Style="{StaticResource SettingsNumberBox}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Loc.DaysUnit}" />
            </StackPanel>
        </controls:SettingsCard>
    </controls:SettingsPanel>
</Page>
