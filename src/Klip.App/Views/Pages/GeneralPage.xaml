<Page
    x:Class="Klip.App.Views.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    Style="{StaticResource SettingsPage}">

    <!-- sem Background (mataria o Mica) e sem ScrollViewer: quem rola e o DynamicScrollViewer
         do NavigationViewContentPresenter. Ver SettingsShell.xaml. -->
    <controls:SettingsPanel Style="{StaticResource SettingsContent}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.SectionGeneral}" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionStartup}" />
        <controls:SettingsCard
            Title="{DynamicResource Loc.StartWithWindows}"
            Description="{DynamicResource Loc.StartWithWindowsCaption}"
            Icon="&#xE7E8;">
            <ui:ToggleSwitch x:Name="AutostartToggle" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionAppearance}" />
        <controls:SettingsCard
            Title="{DynamicResource Loc.ThemeTitle}"
            Description="{DynamicResource Loc.ThemeCaption}"
            Icon="&#xE790;">
            <ComboBox x:Name="ThemeCombo" MinWidth="240" Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>

        <!-- itens montados em codigo (lista de idiomas dinamica) -->
        <controls:SettingsCard
            Title="{DynamicResource Loc.LanguageTitle}"
            Description="{DynamicResource Loc.LanguageCaption}"
            Icon="&#xE774;">
            <ComboBox x:Name="LanguageCombo" MinWidth="240" Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>
    </controls:SettingsPanel>
</Page>
