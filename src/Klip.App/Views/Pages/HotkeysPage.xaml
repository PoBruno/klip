<Page
    x:Class="Klip.App.Views.Pages.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    Style="{StaticResource SettingsPage}">

    <Page.Resources>
        <!-- lapis "editar" ao lado das teclas -->
        <Style x:Key="EditKeyButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource KlipIconFont}"
                                FontSize="14"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="&#xE70F;" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- sem Background (mataria o Mica) e sem ScrollViewer. Ver SettingsShell.xaml. -->
    <controls:SettingsPanel Style="{StaticResource SettingsContent}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.SectionHotkeys}" />

        <!-- so aparece quando algo deu errado ou ha algo a fazer; sucesso nao vira faixa -->
        <ui:InfoBar x:Name="ActionStatus" Margin="0,4,0,0" IsClosable="True" IsOpen="False" />

        <!-- ================= Atalhos do Klip ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionAppHotkeys}" />

        <!-- o conteudo de cada cartao (teclas + lapis, ou "Definir atalho") e o "Assumido do
             Windows" sao montados em codigo: HotkeysPage.BuildCard -->
        <controls:SettingsCard x:Name="HistoryCard" Title="{DynamicResource Loc.OpenHistoryHotkey}" Description="{DynamicResource Loc.HotkeyHistoryCaption}" Icon="&#xE81C;" />
        <controls:SettingsCard x:Name="CaptureCard" Title="{DynamicResource Loc.NewCaptureHotkey}" Description="{DynamicResource Loc.HotkeyCaptureCaption}" Icon="&#xE722;" />
        <controls:SettingsCard x:Name="StopRecCard" Title="{DynamicResource Loc.StopRecordingHotkeyTitle}" Description="{DynamicResource Loc.HotkeyStopCaption}" Icon="&#xE71A;" />
        <controls:SettingsCard x:Name="TextCard" Title="{DynamicResource Loc.HotkeyCaptureTextTitle}" Description="{DynamicResource Loc.HotkeyTextCaption}" Icon="&#xE8D2;" />
        <controls:SettingsCard x:Name="RepeatCard" Title="{DynamicResource Loc.HotkeyRepeatRegionTitle}" Description="{DynamicResource Loc.HotkeyRepeatCaption}" Icon="&#xE72C;" />
        <controls:SettingsCard x:Name="VideoCard" Title="{DynamicResource Loc.HotkeyRecordVideoTitle}" Description="{DynamicResource Loc.HotkeyVideoCaption}" Icon="&#xE714;" />

        <!-- ================= Padroes ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionDefaults}" />
        <controls:SettingsCard
            Title="{DynamicResource Loc.CardRevertTitle}"
            Description="{DynamicResource Loc.CardRevertCaption}"
            Icon="&#xE777;">
            <ui:Button x:Name="RevertButton" Content="{DynamicResource Loc.Revert}" />
        </controls:SettingsCard>

        <!-- ================= Atalhos do painel (so referencia) ================= -->
        <controls:SettingsExpander
            Margin="0,20,0,4"
            Title="{DynamicResource Loc.SectionFlyoutShortcuts}"
            Description="{DynamicResource Loc.FlyoutShortcutsCaption}"
            Icon="&#xE8A1;">
            <controls:SettingsRow>
                <controls:SettingsRow.Footer>
                    <Grid x:Name="PanelShortcutsGrid" Margin="0,-12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </controls:SettingsRow.Footer>
            </controls:SettingsRow>
        </controls:SettingsExpander>
    </controls:SettingsPanel>
</Page>
