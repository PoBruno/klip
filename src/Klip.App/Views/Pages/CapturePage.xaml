<Page
    x:Class="Klip.App.Views.Pages.CapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    Style="{StaticResource SettingsPage}">

    <!-- sem Background (mataria o Mica) e sem ScrollViewer. Ver SettingsShell.xaml. -->
    <controls:SettingsPanel Style="{StaticResource SettingsContent}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.SectionCapture}" />

        <!-- ================= Ao capturar ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionOnCapture}" />

        <!-- os dois combos gravam os mesmos bools de antes (RememberLastCaptureMode e
             AlwaysOpenEditorAfterCapture); escolha explicita le melhor que um interruptor -->
        <controls:SettingsCard
            Title="{DynamicResource Loc.StartModeTitle}"
            Description="{DynamicResource Loc.StartModeCaption}"
            Icon="&#xF407;">
            <ComboBox x:Name="StartModeCombo" MinWidth="240" Style="{StaticResource SettingsComboBox}">
                <ComboBoxItem Content="{DynamicResource Loc.StartModeRectangle}" />
                <ComboBoxItem Content="{DynamicResource Loc.StartModeLast}" />
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.AfterCaptureTitle}"
            Description="{DynamicResource Loc.AfterCaptureCaption}"
            Icon="&#xE70F;">
            <ComboBox x:Name="AfterCaptureCombo" MinWidth="240" Style="{StaticResource SettingsComboBox}">
                <ComboBoxItem Content="{DynamicResource Loc.AfterCaptureToast}" />
                <ComboBoxItem Content="{DynamicResource Loc.AfterCaptureEditor}" />
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.EditorModifierTitle}"
            Description="{DynamicResource Loc.EditorModifierCaption}"
            Icon="&#xE765;">
            <ComboBox x:Name="EditorModifierCombo" MinWidth="160" Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>

        <!-- ================= Selecao ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionSelection}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.MagnifierTitle}"
            Description="{DynamicResource Loc.MagnifierCaption}"
            Icon="&#xE71E;">
            <ui:ToggleSwitch x:Name="MagnifierToggle" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.ColorFormatTitle}"
            Description="{DynamicResource Loc.ColorFormatCaption}"
            Icon="&#xE790;">
            <ComboBox x:Name="ColorFormatCombo" MinWidth="160" Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>

        <!-- ================= Salvar ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionSaving}" />

        <controls:SettingsExpander
            x:Name="AutoSaveExpander"
            Title="{DynamicResource Loc.AutoSaveTitle}"
            Description="{DynamicResource Loc.AutoSaveCaption}"
            Icon="&#xE74E;">
            <controls:SettingsExpander.Header>
                <ui:ToggleSwitch x:Name="AutoSaveToggle" />
            </controls:SettingsExpander.Header>
            <controls:SettingsRow
                x:Name="ScreenshotFolderRow"
                Title="{DynamicResource Loc.ScreenshotFolderTitle}"
                Description="{DynamicResource Loc.ScreenshotFolderCaption}">
                <controls:SettingsRow.Footer>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="ScreenshotFolderBox" IsReadOnly="True" Style="{StaticResource SettingsTextBox}" />
                        <ui:Button
                            x:Name="ChooseFolderButton"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            MinHeight="32"
                            Content="{DynamicResource Loc.ChooseFolder}" />
                    </Grid>
                </controls:SettingsRow.Footer>
            </controls:SettingsRow>
        </controls:SettingsExpander>

        <!-- ================= Captura com rolagem ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionScrolling}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.CadenceTitle}"
            Description="{DynamicResource Loc.CadenceCaption}"
            Icon="&#xE8CB;">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Slider
                    x:Name="ScrollDelaySlider"
                    Width="180"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="2000"
                    Minimum="100"
                    TickFrequency="100" />
                <!-- MinWidth segura o pior caso ("2000 ms") para o slider nao andar -->
                <TextBlock
                    x:Name="ScrollDelayLabel"
                    MinWidth="60"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextAlignment="Right" />
            </StackPanel>
        </controls:SettingsCard>
    </controls:SettingsPanel>
</Page>
