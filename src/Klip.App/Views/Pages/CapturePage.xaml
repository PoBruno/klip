<Page
    x:Class="Klip.App.Views.Pages.CapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    Style="{StaticResource SettingsPage}">

    <!-- no Background (it would kill the Mica) and no ScrollViewer: the
         NavigationViewContentPresenter template already scrolls, and the 24 px
         padding comes from NavigationView.Padding. See SettingsShell.xaml. -->
    <StackPanel MaxWidth="680">

        <!-- the "new capture" hotkey card lives on the hotkeys page, and every
             recording setting (folders, GIF, MP4, ffmpeg) on the recording page -->
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.SectionCapture}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.RememberCaptureModeTitle}"
            Description="{DynamicResource Loc.RememberCaptureModeCaption}"
            Icon="&#xE81C;">
            <ui:ToggleSwitch x:Name="RememberCaptureModeToggle" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.AlwaysEditorTitle}"
            Description="{DynamicResource Loc.AlwaysEditorCaption}"
            Icon="&#xE70F;">
            <ui:ToggleSwitch x:Name="AlwaysEditorToggle" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.EditorModifierTitle}"
            Description="{DynamicResource Loc.EditorModifierCaption}"
            Icon="&#xE765;">
            <ComboBox
                x:Name="EditorModifierCombo"
                Width="140"
                Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.MagnifierTitle}"
            Description="{DynamicResource Loc.MagnifierCaption}"
            Icon="&#xE71E;">
            <ui:ToggleSwitch x:Name="MagnifierToggle" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.ColorFormatTitle}"
            Description="{DynamicResource Loc.ColorFormatCaption}"
            Icon="&#xE790;">
            <ComboBox
                x:Name="ColorFormatCombo"
                Width="140"
                Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.AutoSaveTitle}"
            Description="{DynamicResource Loc.AutoSaveCaption}"
            Icon="&#xE74E;">
            <ui:ToggleSwitch x:Name="AutoSaveToggle" />
        </controls:SettingsCard>

        <!-- stacked card: the box and the button go in the footer -->
        <controls:SettingsCard
            Title="{DynamicResource Loc.ScreenshotFolderTitle}"
            Description="{DynamicResource Loc.ScreenshotFolderCaption}"
            Icon="&#xE8B7;">
            <controls:SettingsCard.Footer>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- read only: the dialog edits, the real path lives in code-behind -->
                    <ui:TextBox
                        x:Name="ScreenshotFolderBox"
                        IsReadOnly="True"
                        Style="{StaticResource SettingsTextBox}" />
                    <ui:Button
                        x:Name="ChooseFolderButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="{DynamicResource Loc.ChooseFolder}" />
                </Grid>
            </controls:SettingsCard.Footer>
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.CadenceTitle}"
            Description="{DynamicResource Loc.CadenceCaption}"
            Icon="&#xE916;">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Slider
                    x:Name="ScrollDelaySlider"
                    Width="140"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="2000"
                    Minimum="100"
                    TickFrequency="100" />
                <!-- MinWidth holds the worst case ("2000 ms") so the slider doesn't
                     slide around while the label changes width during the drag -->
                <TextBlock
                    x:Name="ScrollDelayLabel"
                    MinWidth="52"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    TextAlignment="Right" />
            </StackPanel>
        </controls:SettingsCard>
    </StackPanel>
</Page>
