<Page
    x:Class="Klip.App.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    Style="{StaticResource SettingsPage}">

    <Page.Resources>
        <!-- botao de link no fim do cartao: so o glifo de "abrir fora" -->
        <Style x:Key="OpenLinkButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource KlipIconFont}"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="&#xE8A7;" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- sem Background (mataria o Mica) e sem ScrollViewer. Ver SettingsShell.xaml. -->
    <controls:SettingsPanel Style="{StaticResource SettingsContent}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.SectionAbout}" />

        <!-- identidade. "Klip" e nome proprio, nao entra nas tabelas de idioma -->
        <Border
            Padding="20"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- o icone do Klip: tecla em pixel art, pintada com a cor do texto (segue o tema).
                     EdgeMode Aliased deixa os quadrados com borda reta, como pixel de verdade -->
                <Viewbox Width="64" Height="64" RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True">
                    <Canvas Width="16" Height="16">
                        <Path Data="{StaticResource KlipPixelInk}" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Path Data="{StaticResource KlipPixelEdge}" Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.55" />
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Klip" />
                    <TextBlock Style="{StaticResource CardCaption}" Text="{DynamicResource Loc.AboutText}" />
                    <TextBlock x:Name="VersionText" Margin="0,4,0,0" Style="{StaticResource CardCaption}" />
                </StackPanel>
                <ui:Button
                    x:Name="CopyVersionButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="{DynamicResource Loc.CopyVersion}" />
            </Grid>
        </Border>

        <!-- ================= Links ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionLinks}" />

        <controls:SettingsCard Title="{DynamicResource Loc.LinkSource}" Description="github.com/PoBruno/klip" Icon="&#xE943;">
            <Button Style="{StaticResource OpenLinkButton}" Tag="https://github.com/PoBruno/klip" ToolTip="{DynamicResource Loc.LinkSource}" />
        </controls:SettingsCard>
        <controls:SettingsCard Title="{DynamicResource Loc.LinkIssue}" Description="github.com/PoBruno/klip/issues" Icon="&#xEBE8;">
            <Button Style="{StaticResource OpenLinkButton}" Tag="https://github.com/PoBruno/klip/issues/new/choose" ToolTip="{DynamicResource Loc.LinkIssue}" />
        </controls:SettingsCard>
        <controls:SettingsCard Title="{DynamicResource Loc.LinkReleases}" Icon="&#xE789;">
            <Button Style="{StaticResource OpenLinkButton}" Tag="https://github.com/PoBruno/klip/releases" ToolTip="{DynamicResource Loc.LinkReleases}" />
        </controls:SettingsCard>
        <controls:SettingsCard Title="{DynamicResource Loc.LinkLicense}" Description="GPL-3.0" Icon="&#xE8A5;">
            <Button Style="{StaticResource OpenLinkButton}" Tag="https://github.com/PoBruno/klip/blob/main/LICENSE" ToolTip="{DynamicResource Loc.LinkLicense}" />
        </controls:SettingsCard>
        <controls:SettingsCard Title="{DynamicResource Loc.LinkThirdParty}" Description="Twemoji (CC-BY 4.0), CLDR, WPF-UI, H.NotifyIcon, NAudio" Icon="&#xE8F1;">
            <Button Style="{StaticResource OpenLinkButton}" Tag="https://github.com/PoBruno/klip/blob/main/THIRD-PARTY-NOTICES.md" ToolTip="{DynamicResource Loc.LinkThirdParty}" />
        </controls:SettingsCard>
    </controls:SettingsPanel>
</Page>
