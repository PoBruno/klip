<Page
    x:Class="Klip.App.Views.Pages.PrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    Style="{StaticResource SettingsPage}">

    <!-- no Background (it would kill the Mica) and no ScrollViewer, see SettingsShell.xaml -->
    <StackPanel MaxWidth="680">
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.SectionPrivacy}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.SkipSecretsTitle}"
            Description="{DynamicResource Loc.SkipSecretsCaption}"
            Icon="&#xE72E;">
            <ui:ToggleSwitch x:Name="SkipSecretsToggle" />
        </controls:SettingsCard>

        <!-- only means something while secrets are being detected -->
        <controls:SettingsCard
            x:Name="SecretKeepCard"
            Title="{DynamicResource Loc.SecretKeepTitle}"
            Description="{DynamicResource Loc.SecretKeepCaption}"
            Icon="&#xE916;">
            <ComboBox
                x:Name="SecretKeepCombo"
                Width="160"
                Style="{StaticResource SettingsComboBox}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.ClearOnExitTitle}"
            Description="{DynamicResource Loc.ClearOnExitCaption}"
            Icon="&#xE74D;">
            <ui:ToggleSwitch x:Name="ClearOnExitToggle" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.RestoreClipboardTitle}"
            Description="{DynamicResource Loc.RestoreClipboardCaption}"
            Icon="&#xE7A7;">
            <ui:ToggleSwitch x:Name="RestoreClipboardToggle" />
        </controls:SettingsCard>
    </StackPanel>
</Page>
