<Page
    x:Class="Klip.App.Views.Pages.PrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    Style="{StaticResource SettingsPage}">

    <!-- sem Background (mataria o Mica) e sem ScrollViewer. Ver SettingsShell.xaml. -->
    <controls:SettingsPanel Style="{StaticResource SettingsContent}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.SectionPrivacy}" />

        <!-- ================= Dados sensiveis ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionSensitive}" />
        <controls:SettingsExpander
            x:Name="SecretsExpander"
            Title="{DynamicResource Loc.SkipSecretsTitle}"
            Description="{DynamicResource Loc.SkipSecretsCaption}"
            Icon="&#xE8D7;">
            <controls:SettingsExpander.Header>
                <ui:ToggleSwitch x:Name="SkipSecretsToggle" />
            </controls:SettingsExpander.Header>
            <!-- so faz sentido enquanto os segredos estao sendo detectados -->
            <controls:SettingsRow
                x:Name="SecretKeepCard"
                Title="{DynamicResource Loc.SecretKeepTitle}"
                Description="{DynamicResource Loc.SecretKeepCaption}">
                <ComboBox x:Name="SecretKeepCombo" MinWidth="160" Style="{StaticResource SettingsComboBox}" />
            </controls:SettingsRow>
        </controls:SettingsExpander>

        <!-- ================= Aplicativos ignorados ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionIgnoredApps}" />
        <controls:SettingsExpander
            x:Name="IgnoredAppsExpander"
            Title="{DynamicResource Loc.ExcludedAppsTitle}"
            Description="{DynamicResource Loc.ExcludedAppsCaption}"
            Icon="&#xE8F8;">
            <controls:SettingsRow>
                <controls:SettingsRow.Footer>
                    <StackPanel Margin="0,-12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                x:Name="ExcludeAppBox"
                                PlaceholderText="{DynamicResource Loc.ExcludedAppsPlaceholder}"
                                Style="{StaticResource SettingsTextBox}" />
                            <ui:Button
                                x:Name="AddExcludeButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                MinHeight="32"
                                Content="{DynamicResource Loc.AddApp}" />
                        </Grid>

                        <!-- virtualizacao de verdade: o ScrollViewer mora DENTRO do template (o
                             painel e o IScrollInfo dele) e o MaxHeight da um viewport finito.
                             A roda volta para a pagina em OnListPreviewMouseWheel. -->
                        <ItemsControl
                            x:Name="ExcludedAppsList"
                            MaxHeight="216"
                            Style="{StaticResource AppListStyle}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="{x:Type ItemsControl}">
                                    <ScrollViewer
                                        x:Name="PART_ListScroll"
                                        Focusable="False"
                                        CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </controls:SettingsRow.Footer>
            </controls:SettingsRow>
        </controls:SettingsExpander>

        <!-- ================= Ao sair ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionOnExit}" />
        <controls:SettingsCard
            Title="{DynamicResource Loc.ClearOnExitTitle}"
            Description="{DynamicResource Loc.ClearOnExitCaption}"
            Icon="&#xE74D;">
            <ui:ToggleSwitch x:Name="ClearOnExitToggle" />
        </controls:SettingsCard>
    </controls:SettingsPanel>
</Page>
