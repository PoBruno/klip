<Page
    x:Class="Klip.App.Views.Pages.MaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    Style="{StaticResource SettingsPage}">

    <!-- sem Background (mataria o Mica) e sem ScrollViewer. Ver SettingsShell.xaml. -->
    <controls:SettingsPanel Style="{StaticResource SettingsContent}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.SectionMaintenance}" />

        <!-- ================= Backup ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionBackup}" />

        <controls:SettingsCard
            Title="{DynamicResource Loc.ExportTitle}"
            Description="{DynamicResource Loc.ExportCaption}"
            Icon="&#xEDE1;">
            <ui:Button x:Name="ExportButton" Content="{DynamicResource Loc.ExportHistory}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.ImportTitle}"
            Description="{DynamicResource Loc.ImportCaption}"
            Icon="&#xE8B5;">
            <ui:Button x:Name="ImportButton" Content="{DynamicResource Loc.ImportHistory}" />
        </controls:SettingsCard>

        <!-- ================= Armazenamento ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionStorage}" />

        <!-- contagem e tamanho lidos fora da UI thread (LoadUsage) -->
        <controls:SettingsCard
            x:Name="UsageCard"
            Title="{DynamicResource Loc.UsageTitle}"
            Icon="&#xEDA2;">
            <Button x:Name="OpenDataFolderButton" Style="{StaticResource LinkButton}" Content="{DynamicResource Loc.OpenDataFolder}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Title="{DynamicResource Loc.CompactTitle}"
            Description="{DynamicResource Loc.CompactCaption}"
            Icon="&#xE7B8;">
            <ui:Button x:Name="CompactButton" Content="{DynamicResource Loc.CompactDb}" />
        </controls:SettingsCard>

        <!-- progresso e resultado de exportar, importar e liberar espaco. IsIndeterminate
             segue a Visibility para o storyboard nao animar algo escondido -->
        <ProgressBar
            x:Name="MaintenanceProgress"
            Height="3"
            Margin="4,4,4,0"
            IsIndeterminate="False"
            Visibility="Collapsed" />
        <TextBlock
            x:Name="MaintenanceStatus"
            Margin="4,4,4,0"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource CardCaption}" TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- ================= Diagnostico ================= -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.SectionDiagnostics}" />

        <controls:SettingsExpander
            x:Name="DiagnosticsExpander"
            Title="{DynamicResource Loc.DiagnosticsTitle}"
            Description="{DynamicResource Loc.DiagnosticsCaption}"
            Icon="&#xE9D9;">
            <controls:SettingsExpander.Header>
                <ui:Button x:Name="DiagnosticsButton" Content="{DynamicResource Loc.RunDiagnostics}" />
            </controls:SettingsExpander.Header>
            <controls:SettingsRow>
                <controls:SettingsRow.Footer>
                    <StackPanel Margin="0,-12,0,0">
                        <ProgressBar
                            x:Name="DiagnosticsProgress"
                            Height="3"
                            IsIndeterminate="False"
                            Visibility="Collapsed" />

                        <!-- hooks LL: sem nenhum instalado em repouso, a Raw Input Thread nunca
                             chama o Klip a cada tecla do sistema. Por isso em cima, SemiBold -->
                        <Border
                            x:Name="HookHealthBox"
                            Padding="10,8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="HookHealthText"
                                FontFamily="Consolas"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Style="{StaticResource CardCaption}"
                                TextWrapping="Wrap" />
                        </Border>

                        <TextBlock
                            x:Name="DiagnosticsText"
                            Margin="0,8,0,0"
                            FontFamily="Consolas"
                            Style="{StaticResource CardCaption}"
                            TextWrapping="Wrap" />

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <ui:Button x:Name="CopyDiagnosticsButton" Content="{DynamicResource Loc.DiagCopy}" IsEnabled="False" />
                            <TextBlock
                                x:Name="DiagnosticsStatus"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource CardCaption}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsRow.Footer>
            </controls:SettingsRow>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            x:Name="ResourcesExpander"
            Title="{DynamicResource Loc.ResourcesTitle}"
            Description="{DynamicResource Loc.ResourcesCaption}"
            Icon="&#xE950;">
            <controls:SettingsExpander.Header>
                <ui:Button x:Name="ResourcesButton" Content="{DynamicResource Loc.ResourcesRefresh}" />
            </controls:SettingsExpander.Header>
            <controls:SettingsRow>
                <controls:SettingsRow.Footer>
                    <TextBlock
                        x:Name="ResourcesText"
                        Margin="0,-12,0,0"
                        FontFamily="Consolas"
                        Style="{StaticResource CardCaption}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </controls:SettingsRow.Footer>
            </controls:SettingsRow>
        </controls:SettingsExpander>
    </controls:SettingsPanel>
</Page>
