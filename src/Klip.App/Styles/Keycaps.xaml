<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- keycaps com profundidade: face em cima, aresta escura de 3 px embaixo (borda
         inferior mais grossa). A aresta e um preto translucido para servir nos dois temas:
         sobre face escura ela escurece, sobre face branca vira um cinza medio. -->
    <SolidColorBrush x:Key="KeyCapEdgeBrush" Color="#4D000000" />
    <SolidColorBrush x:Key="KeyCapAccentEdgeBrush" Color="#66000000" />

    <!-- tecla neutra: referencia (atalhos do painel), sugestoes -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KeyCapEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,3" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- tecla de um atalho configurado: cor de destaque, como no PowerToys -->
    <Style x:Key="KeyCapAccent" TargetType="Border" BasedOn="{StaticResource KeyCap}">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KeyCapAccentEdgeBrush}" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- tecla grande da caixa de captura -->
    <Style x:Key="KeyCapLarge" TargetType="Border" BasedOn="{StaticResource KeyCapAccent}">
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="16,0,16,0" />
        <Setter Property="BorderThickness" Value="1,1,1,4" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="KeyCapText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="KeyCapAccentText" TargetType="TextBlock" BasedOn="{StaticResource KeyCapText}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="KeyCapLargeText" TargetType="TextBlock" BasedOn="{StaticResource KeyCapAccentText}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- o "+" pequeno entre as teclas -->
    <Style x:Key="KeyCapPlus" TargetType="TextBlock">
        <Setter Property="Text" Value="+" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0" />
    </Style>

</ResourceDictionary>
