<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    mc:Ignorable="po">

    <!-- ===================================================================== design system da tela de configuracoes. nenhuma cor literal. As variaveis CSS do mockup SAO os brushes do tema do WPF-UI, entao usar as chaves faz o tema claro sair de graca. Registrado em App.xaml DEPOIS de ThemesDictionary/ControlsDictionary - senao o override de brush abaixo nao vence. ===================================================================== -->

    <!-- WPF nao suporta o eixo optico (opsz) das fontes variaveis - isso e recurso do WinUI. A familia por faixa de tamanho e escolhida na mao: Text ate ~18 px, Display acima disso. O default do WPF-UI e "Segoe UI" puro. -->
    <FontFamily x:Key="KlipUiFont">Segoe UI Variable Text, Segoe UI Variable, Segoe UI, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="KlipDisplayFont">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Segoe Fluent Icons e o unico jogo de icones do projeto (AGENTS.md). O
         ui:FontIcon do WPF-UI 4.3 nasce com FontFamily="Segoe UI" (verificado por
         reflexao), entao a familia precisa ser dita explicitamente. -->
    <FontFamily x:Key="KlipIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- o WPF-UI usa o mesmo #0FFFFFFF para hover e para selecionado, o que apaga a diferenca entre "onde o mouse esta" e "onde eu estou". O mockup diferencia: hover mais fraco (#0A) que selecionado (#0F). -->
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0AFFFFFF" po:Freeze="True" />

    <!-- ===================== Tipografia ===================== -->

    <!-- raiz de toda pagina de configuracoes. O System.Windows.Controls.Page reinicia Foreground em SystemColors.ControlTextBrush (PRETO) e FontFamily no default do sistema, cortando a heranca de TextElement.Foreground vinda do Grid raiz do shell - sem isto, titulo de pagina e titulo de cartao saem pretos sobre fundo escuro. O DefaultPageStyle do WPF-UI 4.3 existe, mas so como estilo COM CHAVE: o estilo implicito e casado pelo tipo EXATO do elemento, e as paginas aqui derivam de Page. Sem Background de proposito: isso mataria o Mica. -->
    <Style x:Key="SettingsPage" TargetType="{x:Type Page}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlipUiFont}" />
        <!-- quem rola a pagina e o ui:DynamicScrollViewer que o NavigationViewContentPresenter (um System.Windows.Controls.Frame) coloca no proprio template. O gatilho e a propriedade IsDynamicScrollViewerEnabled, e o presenter a define em OnNavigated copiando ScrollViewer.CanContentScroll da pagina navegada. O valor default ja seria True - o static ctor do presenter faz OverrideMetadata(typeof(Page), true) -, mas so SE a metadata de Page ainda estiver intocada; se qualquer outra biblioteca chegar antes, o override e pulado em silencio, o presenter vem sem scroller nenhum e as 7 paginas voltam a ficar cortadas. Declarar aqui torna o contrato explicito e independente dessa corrida. Nao tem efeito de layout: CanContentScroll so muda comportamento no ScrollViewer que a le do proprio template, nunca no filho. -->
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

    <!-- o Grid raiz do shell herda TextFormattingMode=Display, que quantiza as metricas por pixel inteiro. Isso e bom ate ~16 px e ruim em 28 px (espacamento visivelmente irregular), entao o titulo de pagina volta a Ideal. -->
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KlipDisplayFont}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,6,0,4" />
    </Style>

    <!-- Unico tamanho custom do conjunto: a escala do WPF-UI vai de 14 (BodyStrong)
         direto para 20 (Subtitle), e o mockup pede 16. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,20,0,8" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CardCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- ===================== Controles ===================== -->

    <!-- as alturas default do WPF-UI 4.3 divergem do mockup, que pede 32 nos tres. Medido nesta versao: ComboBox 37 (Padding 10,8,10,8), ui:TextBox 36 (Padding 10,8,10,7) e ui:NumberBox 36 (Padding 10,8,10,7) - os tres com MinHeight 24, ou seja, quem manda na altura e o Padding. E o Padding que corrige (Height fixa quebraria o crescimento do texto em DPI alto); o MinHeight=32 entra so como piso exato: com TextFormattingMode=Display a linha mede 31,62 e o ui:NumberBox tem chao proprio em 31 px (os dois botoes de incremento empilhados), abaixo do qual nenhum Padding faz descer. -->
    <Style x:Key="SettingsComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="11,5,11,6" />
    </Style>

    <Style x:Key="SettingsTextBox" TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5,10,6" />
    </Style>

    <!-- ui:NumberBox e o controle mais caro do conjunto: 35 elementos visuais por
         instancia (medido). Usar com parcimonia - ver a ClipboardPage. -->
    <Style x:Key="SettingsNumberBox" TargetType="{x:Type ui:NumberBox}" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,3,10,4" />
    </Style>

    <!-- ===================== Layout da pagina ===================== -->

    <!-- alinhado a esquerda com teto de 1000, como nas Configuracoes do Windows. Antes era
         uma coluna de 680 centralizada que deixava metade da janela maximizada vazia. -->
    <Style x:Key="SettingsContent" TargetType="controls:SettingsPanel">
        <Setter Property="MaxWidth" Value="1000" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="12,0,12,0" />
    </Style>

    <!-- frase curta logo abaixo do titulo de secao -->
    <Style x:Key="SectionNote" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,-4,0,8" />
    </Style>

    <!-- link em linha (abrir pasta, devolver ao Windows) -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== SettingsCard ===================== -->

    <!-- Estilo implicito: as paginas so escrevem <controls:SettingsCard ... />.
         Coluna do icone sempre reservada (titulos alinham). Em IsNarrow o controle desce
         para baixo do texto. -->
    <ControlTemplate x:Key="SettingsCardTemplate" TargetType="{x:Type controls:SettingsCard}">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Padding="{TemplateBinding Padding}"
            CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
            MinHeight="{TemplateBinding MinHeight}"
            SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="PART_Icon"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource KlipIconFont}"
                    FontSize="20"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{TemplateBinding Icon}" />

                <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PART_Title" TextWrapping="Wrap" Text="{TemplateBinding Title}" />
                    <TextBlock x:Name="PART_Description" Style="{StaticResource CardCaption}" Margin="0,1,0,0" Text="{TemplateBinding Description}" />
                    <ContentPresenter x:Name="PART_Status" Margin="0,4,0,0" Content="{TemplateBinding Status}">
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardCaption}" />
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </StackPanel>

                <ContentPresenter
                    x:Name="PART_Content"
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />

                <ContentPresenter
                    x:Name="PART_Footer"
                    Grid.Row="2"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Margin="0,12,0,0"
                    Content="{TemplateBinding Footer}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsNarrow" Value="True">
                <Setter TargetName="PART_Content" Property="Grid.Row" Value="1" />
                <Setter TargetName="PART_Content" Property="Grid.Column" Value="2" />
                <Setter TargetName="PART_Content" Property="HorizontalAlignment" Value="Left" />
                <Setter TargetName="PART_Content" Property="Margin" Value="0,10,0,0" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="PART_Content" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="PART_Icon" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="Description" Value="{x:Null}">
                <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Description" Value="">
                <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Status" Value="{x:Null}">
                <Setter TargetName="PART_Status" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Status" Value="">
                <Setter TargetName="PART_Status" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Footer" Value="{x:Null}">
                <Setter TargetName="PART_Footer" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_Title" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                <Setter TargetName="PART_Description" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                <Setter TargetName="PART_Icon" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type controls:SettingsCard}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>4</CornerRadius></Setter.Value></Setter>
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{StaticResource SettingsCardTemplate}" />
    </Style>

    <!-- linha dentro de um expansor: sem borda propria, fundo secundario, divisoria em cima -->
    <Style TargetType="{x:Type controls:SettingsRow}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{StaticResource SettingsCardTemplate}" />
    </Style>

    <!-- ===================== SettingsExpander ===================== -->
    <Style TargetType="{x:Type controls:SettingsExpander}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsExpander}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <StackPanel>
                            <Border x:Name="PART_HeaderArea" Background="Transparent" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}" Cursor="Hand">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        x:Name="PART_Icon"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource KlipIconFont}"
                                        FontSize="20"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{TemplateBinding Icon}" />
                                    <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PART_Title" TextWrapping="Wrap" Text="{TemplateBinding Title}" />
                                        <TextBlock x:Name="PART_Description" Style="{StaticResource CardCaption}" Margin="0,1,0,0" Text="{TemplateBinding Description}" />
                                        <ContentPresenter x:Name="PART_Status" Margin="0,4,0,0" Content="{TemplateBinding Status}" />
                                    </StackPanel>
                                    <ContentPresenter
                                        x:Name="PART_HeaderContent"
                                        Grid.Column="3"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Header}" />
                                    <ToggleButton
                                        x:Name="PART_Chevron"
                                        Grid.Column="4"
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Focusable="True"
                                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="B" Background="Transparent" CornerRadius="4">
                                                    <TextBlock
                                                        x:Name="G"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource KlipIconFont}"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="&#xE70D;" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="G" Property="Text" Value="&#xE70E;" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="PART_Body" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="PART_Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsNarrow" Value="True">
                            <Setter TargetName="PART_HeaderContent" Property="Grid.Row" Value="1" />
                            <Setter TargetName="PART_HeaderContent" Property="Grid.Column" Value="2" />
                            <Setter TargetName="PART_HeaderContent" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_HeaderContent" Property="Margin" Value="0,10,0,0" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Null}">
                            <Setter TargetName="PART_Status" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="PART_HeaderContent" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Icone do Klip (pixel 16x16) ===================== -->
    <!-- a tecla em pixel art como geometria: nitida em qualquer DPI e pintada com a cor do
         texto, entao segue o tema (branco no escuro, preto no claro). Mesmo desenho dos .ico. -->
    <Geometry x:Key="KlipPixelInk">M3,1h1v1h-1z M4,1h1v1h-1z M5,1h1v1h-1z M6,1h1v1h-1z M7,1h1v1h-1z M8,1h1v1h-1z M9,1h1v1h-1z M10,1h1v1h-1z M11,1h1v1h-1z M12,1h1v1h-1z M2,2h1v1h-1z M13,2h1v1h-1z M1,3h1v1h-1z M14,3h1v1h-1z M1,4h1v1h-1z M5,4h1v1h-1z M6,4h1v1h-1z M9,4h1v1h-1z M10,4h1v1h-1z M14,4h1v1h-1z M1,5h1v1h-1z M5,5h1v1h-1z M6,5h1v1h-1z M8,5h1v1h-1z M9,5h1v1h-1z M14,5h1v1h-1z M1,6h1v1h-1z M5,6h1v1h-1z M6,6h1v1h-1z M7,6h1v1h-1z M8,6h1v1h-1z M14,6h1v1h-1z M1,7h1v1h-1z M5,7h1v1h-1z M6,7h1v1h-1z M7,7h1v1h-1z M14,7h1v1h-1z M1,8h1v1h-1z M5,8h1v1h-1z M6,8h1v1h-1z M7,8h1v1h-1z M8,8h1v1h-1z M14,8h1v1h-1z M1,9h1v1h-1z M5,9h1v1h-1z M6,9h1v1h-1z M8,9h1v1h-1z M9,9h1v1h-1z M14,9h1v1h-1z M1,10h1v1h-1z M5,10h1v1h-1z M6,10h1v1h-1z M9,10h1v1h-1z M10,10h1v1h-1z M14,10h1v1h-1z M1,11h1v1h-1z M14,11h1v1h-1z M1,12h1v1h-1z M14,12h1v1h-1z M2,13h1v1h-1z M13,13h1v1h-1z M3,14h1v1h-1z M4,14h1v1h-1z M5,14h1v1h-1z M6,14h1v1h-1z M7,14h1v1h-1z M8,14h1v1h-1z M9,14h1v1h-1z M10,14h1v1h-1z M11,14h1v1h-1z M12,14h1v1h-1z</Geometry>
    <Geometry x:Key="KlipPixelEdge">M4,12h1v1h-1z M5,12h1v1h-1z M6,12h1v1h-1z M7,12h1v1h-1z M8,12h1v1h-1z M9,12h1v1h-1z M10,12h1v1h-1z M11,12h1v1h-1z</Geometry>

    <!-- ===================== Listas de apps (apps ignorados, apps que mantem formatacao) ===================== -->
    <!-- o botao de remover nao tem Click: sobe ate o ItemsControl, onde um handler le o DataContext -->
    <DataTemplate x:Key="AppRowTemplate">
        <Border
            Margin="0,0,0,4"
            Padding="12,6,6,6"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
            CornerRadius="4">
            <Grid>
                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                <Button
                    HorizontalAlignment="Right"
                    Padding="8,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="{DynamicResource Loc.RemoveApp}"
                    AutomationProperties.Name="{DynamicResource Loc.RemoveApp}">
                    <TextBlock FontFamily="{StaticResource KlipIconFont}" FontSize="12" Text="&#xE74D;" />
                </Button>
            </Grid>
        </Border>
    </DataTemplate>

    <Style x:Key="AppListStyle" TargetType="{x:Type ItemsControl}">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="ItemTemplate" Value="{StaticResource AppRowTemplate}" />
        <Style.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
