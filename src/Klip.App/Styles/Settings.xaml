<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Klip.App.Controls"
    mc:Ignorable="po">

    <!-- =====================================================================
         RF-S.01 - design system da tela de configuracoes.
         ADR-S.04: nenhuma cor literal. As variaveis CSS do mockup SAO os brushes
         do tema do WPF-UI, entao usar as chaves faz o tema claro sair de graca.
         Registrado em App.xaml DEPOIS de ThemesDictionary/ControlsDictionary -
         senao o override de brush abaixo nao vence.
         ===================================================================== -->

    <!-- RF-S.10: WPF nao suporta o eixo optico (opsz) das fontes variaveis - isso e
         recurso do WinUI. A familia por faixa de tamanho e escolhida na mao: Text ate
         ~18 px, Display acima disso. O default do WPF-UI e "Segoe UI" puro. -->
    <FontFamily x:Key="KlipUiFont">Segoe UI Variable Text, Segoe UI Variable, Segoe UI, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="KlipDisplayFont">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Segoe Fluent Icons e o unico jogo de icones do projeto (AGENTS.md). O
         ui:FontIcon do WPF-UI 4.3 nasce com FontFamily="Segoe UI" (verificado por
         reflexao), entao a familia precisa ser dita explicitamente. -->
    <FontFamily x:Key="KlipIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- RF-S.01: o WPF-UI usa o mesmo #0FFFFFFF para hover e para selecionado, o que
         apaga a diferenca entre "onde o mouse esta" e "onde eu estou". O mockup
         diferencia: hover mais fraco (#0A) que selecionado (#0F). -->
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0AFFFFFF" po:Freeze="True" />

    <!-- ===================== Tipografia ===================== -->

    <!-- RF-S.01 / RF-S.10: raiz de toda pagina de configuracoes.
         O System.Windows.Controls.Page reinicia Foreground em
         SystemColors.ControlTextBrush (PRETO) e FontFamily no default do sistema,
         cortando a heranca de TextElement.Foreground vinda do Grid raiz do shell -
         sem isto, titulo de pagina e titulo de cartao saem pretos sobre fundo escuro.
         O DefaultPageStyle do WPF-UI 4.3 existe, mas so como estilo COM CHAVE: o
         estilo implicito e casado pelo tipo EXATO do elemento, e as paginas aqui
         derivam de Page. Sem Background de proposito: isso mataria o Mica. -->
    <Style x:Key="SettingsPage" TargetType="{x:Type Page}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlipUiFont}" />
        <!-- RF-S.03: quem rola a pagina e o ui:DynamicScrollViewer que o
             NavigationViewContentPresenter (um System.Windows.Controls.Frame) coloca no
             proprio template. O gatilho e a propriedade IsDynamicScrollViewerEnabled, e
             o presenter a define em OnNavigated copiando ScrollViewer.CanContentScroll
             da pagina navegada. O valor default ja seria True - o static ctor do
             presenter faz OverrideMetadata(typeof(Page), true) -, mas so SE a metadata
             de Page ainda estiver intocada; se qualquer outra biblioteca chegar antes,
             o override e pulado em silencio, o presenter vem sem scroller nenhum e as
             7 paginas voltam a ficar cortadas. Declarar aqui torna o contrato explicito
             e independente dessa corrida. Nao tem efeito de layout: CanContentScroll so
             muda comportamento no ScrollViewer que a le do proprio template, nunca no
             filho. -->
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

    <!-- RF-S.01 / RF-P4.01: o Grid raiz do shell herda TextFormattingMode=Display, que
         quantiza as metricas por pixel inteiro. Isso e bom ate ~16 px e ruim em 28 px
         (espacamento visivelmente irregular), entao o titulo de pagina volta a Ideal. -->
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KlipDisplayFont}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,6,0,4" />
    </Style>

    <!-- Unico tamanho custom do conjunto: a escala do WPF-UI vai de 14 (BodyStrong)
         direto para 20 (Subtitle), e o mockup pede 16. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,20,0,8" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CardCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- ===================== Controles ===================== -->

    <!-- RF-S.01: as alturas default do WPF-UI 4.3 divergem do mockup, que pede 32 nos
         tres. Medido nesta versao: ComboBox 37 (Padding 10,8,10,8), ui:TextBox 36
         (Padding 10,8,10,7) e ui:NumberBox 36 (Padding 10,8,10,7) - os tres com
         MinHeight 24, ou seja, quem manda na altura e o Padding. E o Padding que
         corrige (Height fixa quebraria o crescimento do texto em DPI alto); o
         MinHeight=32 entra so como piso exato: com TextFormattingMode=Display a
         linha mede 31,62 e o ui:NumberBox tem chao proprio em 31 px (os dois botoes
         de incremento empilhados), abaixo do qual nenhum Padding faz descer. -->
    <Style x:Key="SettingsComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="11,5,11,6" />
    </Style>

    <Style x:Key="SettingsTextBox" TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5,10,6" />
    </Style>

    <!-- ui:NumberBox e o controle mais caro do conjunto: 35 elementos visuais por
         instancia (medido). Usar com parcimonia - ver a ClipboardPage. -->
    <Style x:Key="SettingsNumberBox" TargetType="{x:Type ui:NumberBox}" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,3,10,4" />
    </Style>

    <!-- ===================== SettingsCard (RF-S.02 / ADR-S.05) ===================== -->

    <!-- Estilo implicito: as paginas so escrevem <controls:SettingsCard ... />.
         9 elementos visuais no template; os opcionais colapsam por Trigger sobre a
         propria DP (nada de converter, que alocaria uma instancia por card). -->
    <Style TargetType="{x:Type controls:SettingsCard}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsCard}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                x:Name="PART_Icon"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource KlipIconFont}"
                                FontSize="16"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{TemplateBinding Icon}" />

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="PART_Title"
                                    Style="{StaticResource CardTitle}"
                                    Text="{TemplateBinding Title}" />
                                <TextBlock
                                    x:Name="PART_Description"
                                    Style="{StaticResource CardCaption}"
                                    Text="{TemplateBinding Description}" />
                                <TextBlock
                                    x:Name="PART_Status"
                                    Margin="0,6,0,0"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource CardCaption}"
                                    Text="{TemplateBinding Status}" />
                            </StackPanel>

                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="2"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                            <ContentPresenter
                                x:Name="PART_Footer"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="0,10,0,0"
                                Content="{TemplateBinding Footer}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Null}">
                            <Setter TargetName="PART_Status" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Status" Value="">
                            <Setter TargetName="PART_Status" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="PART_Footer" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
