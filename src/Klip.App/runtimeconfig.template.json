{
  // runtime knobs, merged by the SDK into bin/<cfg>/<tfm>/Klip.runtimeconfig.json.
  // values here are decimal (the DOTNET_* env var versions take hex).
  "configProperties": {
    // workstation GC. server GC means one heap plus one high priority GC thread per
    // logical CPU, way too much for a tray app that idles most of the time
    "System.GC.Server": false,

    // background GC on. with false every gen2 is blocking and runs on the allocating
    // thread; a long pause there can starve the LL input hooks, and if they miss
    // LowLevelHooksTimeout windows drops them (and input for the whole system lags)
    "System.GC.Concurrent": true,

    // give freed regions back to the OS instead of parking them on a standby list.
    // we sit idle in the tray, so a smaller footprint wins over a cheaper re-commit
    "System.GC.RetainVM": false,

    // 0-9 scale. anything above 0 lets the GC compact the LOH when it gets fragmented,
    // which matters here: clipboard images, screenshots and stitched captures all land
    // on the LOH. the docs suggest 5-7, we stay at the bottom of that range
    "System.GC.ConserveMemory": 5,

    // DATAS only does something with server GC, keep it off so the intent is obvious
    "System.GC.DynamicAdaptationMode": 0,

    // tiered compilation + quick jit (defaults). turning either off makes startup a lot
    // slower, and we start with windows, fighting everything else at logon
    "System.Runtime.TieredCompilation": true,
    "System.Runtime.TieredCompilation.QuickJit": true,

    // quick jit for methods with loops too (default). most parsing/stitching code loops,
    // and OSR takes care of the long running ones
    "System.Runtime.TieredCompilation.QuickJitForLoops": true,

    // full ICU. invariant mode would break the 15 UI languages and the culture aware
    // search and sorting of the history (accents, turkish i, CJK)
    "System.Globalization.Invariant": false,

    // new exception handling (default). just makes it explicit we do not need the
    // legacy path; ignored if the runtime no longer ships it
    "System.Runtime.LegacyExceptionHandling": false

    // --- left out on purpose ---
    //
    // "System.GC.HeapHardLimit": <bytes>
    //   hitting the limit throws OutOfMemoryException, it does not collect harder. one big
    //   scrolling capture or an 8K image on the clipboard would blow any sane cap, and the
    //   GC also reserves a lot of address space up front once a hard limit is set.
    //   ConserveMemory + RetainVM=false cover the real case without the OOM risk.
    //
    // "System.GC.RegionSize": 1048576
    //   real runtimeconfig key since .NET 10 (before that only the DOTNET_GCRegionSize env
    //   var, in hex). 1 MB regions cut the GC bookkeeping for small heaps, but we also get
    //   bursts of big bitmaps and nobody measured how that behaves with smaller regions.
    //   off until there is a before/after of idle working set and capture latency.
  }
}
