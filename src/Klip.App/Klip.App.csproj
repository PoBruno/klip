<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Klip</AssemblyName>
    <RootNamespace>Klip.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Klip.ico</ApplicationIcon>
    <!-- Hosting 10.x pulls a newer System.Text.Json than the net9 inbox one -->
    <NoWarn>$(NoWarn)</NoWarn>

    <!-- exe metadata -->
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <Product>Klip</Product>
    <Company>PoBruno</Company>
    <Description>Clipboard history and screen capture for Windows 11</Description>
    <Copyright>Copyright 2026</Copyright>

    <!-- publish options (self-contained, single-file) live in the build scripts,
         not here, so the debug build keeps the default output path (no RID subfolder). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- RF-P3.02: R2R pre-compila o codigo do Klip + WPF-UI + Mvvm. As libs do framework ja vem R2R.
         Exige RID no publish (os scripts em tools/ e o release.yml sempre passam -r win-x64). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Composite so e recomendado para apps que DESLIGAM tiering; aqui pioraria:
         geraria uma unica imagem gigante e invalidaria o R2R que ja vem com o framework. -->
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <!-- PGO dinamico: o tier 0 instrumenta e o tier 1 reotimiza com os dados reais. -->
    <TieredPGO>true</TieredPGO>
    <!-- Feature switches: desativam codigo em runtime mesmo sem trimming.
         O Klip nao publica EventSource nem Meter (nenhum uso no codigo). -->
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <!-- Trimming e AOT sao IMPOSSIVEIS com WPF: o SDK emite TrimmingWpfIsNotSupported (erro, nao warning). -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klip.Core\Klip.Core.csproj" />
    <ProjectReference Include="..\Klip.Interop\Klip.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Twemoji PNGs (CC-BY 4.0) + the search index, embedded so it all works offline -->
    <Resource Include="Assets\Emoji\*.png" />
    <Resource Include="Assets\Emoji\emoji-index.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.9" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
